{
  "name": "leefowlercu-agent-kit",
  "owner": {
    "name": "Lee Fowler"
  },
  "metadata": {
    "description": "LeeFowlerCU's Agent Kit",
    "version": "1.0.0"
  },
  "plugins": [
    {
      "name": "project-docs-reconciler",
      "description": "Provides skills to initialize or reconcile project documentation (README.md, CLAUDE.md, subsystem docs)",
      "version": "0.2.0",
      "author": {
        "name": "Lee Fowler"
      },
      "keywords": ["documentation", "readme", "claude-md", "reconciliation"],
      "category": "documentation",
      "license": "MIT",
      "strict": false,
      "source": "./plugins/project-docs-reconciler"
    },
    {
      "name": "op-secrets-manager",
      "description": "Skills for interacting with 1Password through the op CLI",
      "version": "0.2.0",
      "author": {
        "name": "Lee Fowler"
      },
      "keywords": ["1password", "secrets", "credentials", "op", "cli"],
      "category": "security",
      "license": "MIT",
      "strict": false,
      "source": "./plugins/op-secrets-manager"
    },
    {
      "name": "gtasks-todo-manager",
      "description": "Manages to-dos across multiple Google accounts using the Google Tasks API",
      "version": "0.5.0",
      "author": {
        "name": "Lee Fowler"
      },
      "keywords": ["google-tasks", "todo", "task-management", "productivity", "multi-account"],
      "category": "productivity",
      "license": "MIT",
      "strict": false,
      "source": "./plugins/gtasks-todo-manager"
    },
    {
      "name": "spec-governed-development",
      "description": "Spec-governed project documentation and implementation workflows for intent-driven development",
      "version": "0.2.0",
      "author": {
        "name": "Lee Fowler"
      },
      "keywords": ["specs", "prd", "adr", "bdd", "tdd", "implementation", "spec-governed-development"],
      "category": "productivity",
      "license": "MIT",
      "strict": false,
      "source": "./plugins/spec-governed-development"
    },
    {
      "name": "bro",
      "description": "Restates the previous assistant message in plain, concise language",
      "version": "0.1.0",
      "author": {
        "name": "Lee Fowler"
      },
      "keywords": ["plain-language", "rewrite", "clarity", "concise", "productivity"],
      "category": "productivity",
      "license": "MIT",
      "strict": false,
      "source": "./plugins/bro"
    },
    {
      "name": "go-standards",
      "description": "Stdlib-grounded Go engineering standards for implementation, review, refactoring, and testing",
      "version": "0.1.3",
      "author": {
        "name": "Lee Fowler"
      },
      "keywords": ["go", "golang", "standards", "testing", "cobra", "viper", "code-review"],
      "category": "development",
      "license": "MIT",
      "strict": false,
      "source": "./plugins/go-standards"
    },
    {
      "name": "hermes-tweet",
      "description": "Guide read-first X/Twitter research and approval-gated Hermes Agent actions",
      "version": "0.1.11",
      "author": {
        "name": "Xquik"
      },
      "keywords": ["hermes-agent", "twitter", "social-research", "workflow"],
      "category": "productivity",
      "license": "MIT",
      "strict": false,
      "source": "./plugins/hermes-tweet"
    }
  ]
}
